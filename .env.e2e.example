# Copy this file to .env.e2e.local (ignored by Git).
# Existing disposable TEST accounts only. Do not use real patient accounts.
# Keep credentials local; do not paste them into chat.
E2E_BASE_URL=https://wellnest-healthcare.vercel.app
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=
E2E_HOSPITAL_EMAIL=
E2E_HOSPITAL_PASSWORD=
E2E_LABORATORY_EMAIL=
E2E_LABORATORY_PASSWORD=
E2E_PHARMACY_EMAIL=
E2E_PHARMACY_PASSWORD=
E2E_INSURANCE_EMAIL=
E2E_INSURANCE_PASSWORD=
E2E_ADMINISTRATOR_EMAIL=
E2E_ADMINISTRATOR_PASSWORD=
# Set only when these test accounts may create clearly marked test records.
E2E_ALLOW_TEST_WRITES=false
