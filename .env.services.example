# Server-only settings. Copy needed settings to Vercel's production environment.
# Never prefix these secrets with VITE_. No provider is enabled by this template.
PUBLIC_APP_URL=https://wellnest-healthcare.vercel.app
DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Local email setup helper only; use your Resend account's own email.
EMAIL_TEST_RECIPIENT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Use a long random secret for the authenticated delivery worker.
CRON_SECRET=
# Private HTTPS gateway ending in /scan. Deploy services/file-scanner first.
SCAN_SERVICE_URL=
SCAN_API_TOKEN=
