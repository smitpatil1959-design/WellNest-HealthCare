# Copy to .env.local and configure your own Supabase project.
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server only. Never expose this value through a VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional delivery/scanning settings are in .env.services.example.
# Keep automatic delivery disabled until providers and receipt tests are ready.
PUBLIC_APP_URL=http://localhost:5173
DELIVERY_ENABLED=false
